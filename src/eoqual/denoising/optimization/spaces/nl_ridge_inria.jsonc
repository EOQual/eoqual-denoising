{
  // Espace de recherche de « nl_ridge_inria » — chargé par optimization/search_spaces.py.
  // NL-Ridge, code des auteurs (clone externe AGPL). 6 dimensions : budget 50-80. Point de départ = palier des auteurs pour 15 < σ ≤ 35 ([0, 255]).
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Multiplie σ.
    {"name": "sigma_scale", "type": "float", "low": 0.5, "high": 2.0},
    // Taille de patch, étape 1.
    {"name": "p1", "type": "int", "low": 5, "high": 13},
    // Taille de patch, étape 2.
    {"name": "p2", "type": "int", "low": 5, "high": 13},
    // Nombre de patchs similaires, étape 1.
    {"name": "k1", "type": "int", "low": 10, "high": 40},
    // Nombre de patchs similaires, étape 2.
    {"name": "k2", "type": "int", "low": 30, "high": 150},
    // Contrainte sur les poids de la régression (linear ou affine).
    {"name": "constraints", "type": "categorical", "categories": ["linear", "affine"]},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"sigma_scale": 1.0, "p1": 9, "p2": 9, "k1": 18, "k2": 90, "constraints": "linear"},
}
