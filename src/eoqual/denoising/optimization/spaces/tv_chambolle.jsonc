{
  // Espace de recherche de « tv_chambolle » — chargé par optimization/search_spaces.py.
  // Variation totale, solveur de Chambolle. 1 dimension : budget 10-15.
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Poids de régularisation, × σ (plus grand = plus lisse). Défaut calibré 0,75.
    {"name": "weight", "type": "float", "low": 0.1, "high": 3.0, "scale": "sigma"},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"weight": 0.75},
}
