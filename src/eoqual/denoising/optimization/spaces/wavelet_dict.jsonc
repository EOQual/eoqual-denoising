{
  // Espace de recherche de « wavelet_dict » — chargé par optimization/search_spaces.py.
  // Dictionnaire d'ondelettes (deepinv + ptwt).
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Seuil doux, × σ. Défaut calibré 1,25.
    {"name": "threshold", "type": "float", "low": 0.3, "high": 4.0, "scale": "sigma"},
    // Niveaux de décomposition.
    {"name": "level", "type": "int", "low": 1, "high": 5},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"threshold": 1.25, "level": 3},
}
