{
  // Espace de recherche de « bm3d » — chargé par optimization/search_spaces.py.
  // BM3D (paquet bm3d, non commercial) : déjà optimal à σ connu sur le benchmark.
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Multiplie σ.
    {"name": "sigma_scale", "type": "float", "low": 0.5, "high": 2.0},
    // Profil de paramètres du paquet bm3d (np normal, refilter, vn, high).
    {"name": "profile", "type": "categorical", "categories": ["np", "refilter", "vn", "high"]},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"sigma_scale": 1.0, "profile": "np"},
}
