{
  // Espace de recherche de « nl_means » — chargé par optimization/search_spaces.py.
  // Non-Local Means (scikit-image). 3 dimensions : budget 20-30. Attention au sur-apprentissage (BENCHMARK.md §3).
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Décroissance des poids, × σ. Doc scikit-image : 0,6 σ (mode rapide).
    {"name": "h", "type": "float", "low": 0.2, "high": 1.5, "scale": "sigma"},
    // Taille des patchs (px).
    {"name": "patch_size", "type": "int", "low": 3, "high": 11},
    // Demi-fenêtre de recherche (px). Petite : rapide mais groupes pauvres.
    {"name": "patch_distance", "type": "int", "low": 3, "high": 21},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"h": 0.6, "patch_size": 7, "patch_distance": 11},
}
