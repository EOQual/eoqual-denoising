{
  // Espace de recherche de « nl_bayes » — chargé par optimization/search_spaces.py.
  // NL-Bayes natif (MIT). 7 dimensions : budget 40-60, n_initial_points ≈ 15-20. Point de départ = article pour σ < 50 ([0, 255]), niveaux de gris. Imbrications gérées par la méthode : N suit k (30/60/90), fenêtre n = window_factor × k, N ≥ k² + 1. Voir REFERENCE_TECHNIQUE.md §2.6.
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Multiplie σ : compense un σ estimé biaisé ; après démosaïçage, c'est le facteur C = √κ_Y + 0.2 (jusqu'à 1,8). Agit sur β·σ² et γσ.
    // β₁, β₂ et γ ne sont PAS dans l'espace : multiplier σ par s équivaut exactement à multiplier β₁, β₂ par s² et γ par s
    // (vérifié : sorties identiques). Optimiser les quatre ajoute une direction sans effet. On garde sigma_scale (un seul levier,
    // commun à toutes les méthodes, interprétable comme le facteur C) et β₁, β₂, γ à leurs valeurs de l'article : γ = 1,05 et β₁ = 1 quel que
    // soit σ (l'article ne les lie pas à σ ; c'est le seuil γσ qui suit σ), β₂ = 1,2 si σ < 50, sinon 1. Voir OPTIMISATION.md §2.3.
    {"name": "sigma_scale", "type": "float", "low": 0.5, "high": 2.5},
    // Taille de patch, étape 1 (article : 5 en gris, 7 à fort bruit). Fixe aussi N₁ et n₁.
    {"name": "k1", "type": "categorical", "categories": [3, 5, 7]},
    // Taille de patch, étape 2.
    {"name": "k2", "type": "categorical", "categories": [3, 5, 7]},
    // α, fenêtre de recherche n = α·k (article : 7). Plus grand : meilleurs groupes, plus lent.
    {"name": "window_factor", "type": "float", "low": 3.0, "high": 9.0},
    // Seuil minimal de similarité de l'étape 2 (niveaux² sur [0, 255]). Article : 4, vérifié robuste (REFERENCE_TECHNIQUE.md §4.2) ; l'optimum dépend du contenu (jusqu'à ~30 en couleur).
    {"name": "tau0", "type": "float", "low": 0.0, "high": 32.0},
    // Critère homogène à l'étape 1 (article : oui).
    {"name": "use_area1", "type": "categorical", "categories": [true, false]},
    // Critère homogène à l'étape 2 (article : non).
    {"name": "use_area2", "type": "categorical", "categories": [true, false]},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"sigma_scale": 1.0, "k1": 5, "k2": 5, "window_factor": 7.0, "tau0": 4.0, "use_area1": true, "use_area2": false},
}
