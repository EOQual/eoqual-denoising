{
  // Espace de recherche de « tv_bregman » — chargé par optimization/search_spaces.py.
  // Variation totale, split Bregman. Sens du poids inversé par rapport à Chambolle.
  // Bornes des dimensions à échelle : multiples de σ ("scale": "sigma") ou de 1/σ ("inverse_sigma"). sigma_scale multiplie le σ transmis.
  "search_space": [
    // Poids de l'attache aux données, × 1/σ (plus grand = moins lisse). Optimum benchmark ≈ 1,5.
    {"name": "weight", "type": "float", "low": 0.1, "high": 5.0, "scale": "inverse_sigma"},
    // TV isotrope ou anisotrope (anisotrope meilleure sur le benchmark).
    {"name": "isotropic", "type": "categorical", "categories": [true, false]},
  ],
  // Point de départ (évalué en premier) : réglages par défaut de la méthode.
  "initial_guess": {"weight": 1.0, "isotropic": true},
}
